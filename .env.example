# Discord Webhook URL (optionnel) — crée un webhook dans les paramètres de ton salon Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/XXXX

# Email notifications (optionnel) — utilise un "mot de passe d'application" Gmail
EMAIL_SENDER=ton.email@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_RECEIVER=ton.email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Intervalle de vérification en secondes (défaut: 120 = 2 minutes)
CHECK_INTERVAL=120

# Clé secrète Flask (change-la)
SECRET_KEY=change-moi-avec-une-vraie-cle
