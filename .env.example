# Discord Webhook URL (optionnel) — crée un webhook dans les paramètres de ton salon Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/XXXX

# Email notifications (optionnel) — utilise un "mot de passe d'application" Gmail
EMAIL_SENDER=ton.email@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_RECEIVER=ton.email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Telegram (optionnel) — notification push sur ton telephone
# 1. Ouvre Telegram, cherche @BotFather, envoie /newbot et suis les instructions → tu recois un token
# 2. Envoie un message a ton bot, puis ouvre https://api.telegram.org/bot<TON_TOKEN>/getUpdates
#    → copie le "chat_id" dans la reponse JSON
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Intervalle de vérification en secondes (minimum: 30, défaut: 30)
CHECK_INTERVAL=30

# Clé secrète Flask (change-la)
SECRET_KEY=change-moi-avec-une-vraie-cle
